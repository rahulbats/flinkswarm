# Copy to .env and fill in. .env is gitignored.

# ---- Confluent Cloud Kafka ----
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-west-2.aws.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=<confluent-cloud-api-key>
KAFKA_SASL_PASSWORD=<confluent-cloud-api-secret>

# ---- Confluent Cloud Schema Registry (Stream Governance) ----
# Unset -> workers fall back to plain JSON (fine for local, not for Flink).
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-west-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=<sr-api-key>
SCHEMA_REGISTRY_API_SECRET=<sr-api-secret>

# ---- Local model server (OpenAI-compatible: omlx / LM Studio / mlx_lm.server) ----
MLX_BASE_URL=http://localhost:10240/v1
MLX_MODEL=<exact id from GET /v1/models>
MLX_API_KEY=not-needed
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ITERS=6
# 1 = print every model request/response (system prompt, tool calls, results)
LLM_LOG_PROMPTS=0

# ---- Swarm ----
SWARM_SPEC=agent-spec.yaml
# Default worker identity when running `python -m flinkswarm.worker` with no
# AGENT_NAME set. run_swarm.sh overrides this per process.
AGENT_NAME=ClaimDataAgent
